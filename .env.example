# Copy to .env (gitignored) and adjust. Read by api/app/config.py and docker-compose.yml.
# Values below match the docker-compose ports as seen from the host.

POSTGRES_PASSWORD=ztdb
PG_DSN=postgresql://ztdb:ztdb@localhost:5544/ztdb
PG_READER_DSN=postgresql://ztdb_reader:ztdb_reader@localhost:5544/ztdb
MONGO_URI=mongodb://localhost:27018
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ztdb-neo4j
ZK_URL=http://localhost:7000

# Demo controls (/api/demo/reset, business-day, tamper). Turn off on any public server,
# or set a token that callers must send as the X-Admin-Token header.
ZTDB_DEMO_MODE=on
ZTDB_ADMIN_TOKEN=

# Optional external anchoring of the transparency log: off | file | github
ZTDB_EXTERNAL_ANCHOR=off
# file mode: append-only JSON-lines file outside the database (e.g. a synced/shared folder)
ZTDB_EXTERNAL_ANCHOR_FILE=
# github mode: commits each anchor to a file in a (public) repository you control
ZTDB_GITHUB_TOKEN=
ZTDB_GITHUB_REPO=
ZTDB_GITHUB_PATH=anchors.jsonl
ZTDB_GITHUB_BRANCH=main
